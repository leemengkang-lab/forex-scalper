# Copy to .env on the VM (mode 600). NEVER commit .env.
# Live trading: use OANDA_ENVIRONMENT=live and live token + account.
# Demo trading: use OANDA_ENVIRONMENT=practice (default).

OANDA_TOKEN=YOUR_OANDA_API_TOKEN_HERE
OANDA_ACCOUNT_ID=001-001-XXXXXXX-001
OANDA_ENVIRONMENT=practice

TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# Inverse mode: comma-separated pairs whose signals are taken on the OPPOSITE
# side (buy<->sell). Empty/unset = normal trading. Example: EUR_USD
INVERT_INSTRUMENTS=
